{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/teacher-enrichment.schema.json",
  "title": "Teacher Enrichment Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_source_id",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_source_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "analysis": {
            "type": "string",
            "minLength": 1
          },
          "teacher_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
