{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/source-manifest.schema.json",
  "title": "Private Source Manifest Item",
  "description": "Schema for private source-vault inventory. Full records are not publication data.",
  "type": "object",
  "required": ["path", "size", "sha256", "extension", "subject", "source_class", "role", "parser_lane", "pair_key", "rights_status", "import_status"],
  "additionalProperties": false,
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "size": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extension": {"type": "string"},
    "subject": {"enum": ["chinese", "mathematics", "english", "politics", "unknown"]},
    "year": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2099},
    "source_class": {"enum": ["past_exam", "mock_exam", "study_note", "reference", "syllabus", "mind_map", "other"]},
    "role": {"enum": ["student", "teacher", "solution", "answer", "mixed", "standalone"]},
    "parser_lane": {"enum": ["docx", "legacy_doc", "pdf_probe", "image_ocr", "unsupported"]},
    "pair_key": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "rights_status": {"enum": ["unknown", "internal_only", "redistributable", "original"]},
    "import_status": {"enum": ["discovered", "probed", "parsed", "reviewed", "rejected"]}
  }
}
