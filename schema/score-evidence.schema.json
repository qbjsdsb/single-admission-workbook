{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/score-evidence.schema.json",
  "title": "Source-derived Score Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "candidate_source_id",
    "sections",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "enum": [
        "english",
        "politics"
      ]
    },
    "candidate_source_id": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_key",
          "heading",
          "heading_source",
          "heading_text_sha256",
          "candidate_count",
          "declared_count",
          "per_question_score",
          "full_score",
          "per_question_source",
          "full_score_source",
          "status",
          "reasons"
        ],
        "additionalProperties": false,
        "properties": {
          "section_key": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string"
          },
          "heading_source": {
            "enum": ["source", "inferred"]
          },
          "heading_locator": {
            "type": "string",
            "minLength": 1
          },
          "heading_text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0
          },
          "declared_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "per_question_score": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "full_score": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "per_question_source": {
            "enum": [
              "explicit",
              "derived_from_exam_total_residual",
              null
            ]
          },
          "full_score_source": {
            "enum": [
              "explicit",
              "derived_from_count_times_per_question",
              "derived_from_exam_total_residual",
              null
            ]
          },
          "status": {
            "enum": [
              "usable",
              "incomplete",
              "conflict"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "residual_resolution": {
            "type": "object",
            "required": [
              "method",
              "total_score",
              "total_locator",
              "total_text_sha256",
              "scope_section_keys",
              "other_section_scores",
              "target_question_count",
              "residual_score",
              "per_question_score"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "explicit_volume_total_residual",
                  "automatic_explicit_volume_total_residual"
                ]
              },
              "total_score": { "type": "number", "exclusiveMinimum": 0 },
              "total_locator": { "type": "string", "minLength": 1 },
              "total_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "scope_section_keys": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2,
                "uniqueItems": true
              },
              "other_section_scores": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["section_key", "score", "source_locator", "source_text_sha256"],
                  "additionalProperties": false,
                  "properties": {
                    "section_key": { "type": "string", "minLength": 1 },
                    "score": { "type": "number", "exclusiveMinimum": 0 },
                    "source_locator": { "type": "string", "minLength": 1 },
                    "source_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                  }
                }
              },
              "target_question_count": { "type": "integer", "minimum": 1 },
              "residual_score": { "type": "number", "exclusiveMinimum": 0 },
              "per_question_score": { "type": "number", "exclusiveMinimum": 0 },
              "reviewer": { "type": "string", "minLength": 1 },
              "reviewed_at": { "type": "string", "format": "date" },
              "review_note": { "type": "string", "minLength": 1 },
              "rule_version": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "method": { "const": "explicit_volume_total_residual" }
                  },
                  "required": ["method"]
                },
                "then": {
                  "required": ["reviewer", "reviewed_at", "review_note"]
                }
              },
              {
                "if": {
                  "properties": {
                    "method": { "const": "automatic_explicit_volume_total_residual" }
                  },
                  "required": ["method"]
                },
                "then": {
                  "required": ["rule_version"]
                }
              }
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_sections",
        "usable",
        "incomplete",
        "conflict"
      ],
      "additionalProperties": false,
      "properties": {
        "total_sections": {
          "type": "integer",
          "minimum": 0
        },
        "usable": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
