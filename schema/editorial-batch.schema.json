{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/editorial-batch.schema.json",
  "title": "Private Editorial Production Batch",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "subject",
    "chapter",
    "section",
    "questions",
    "occurrences"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "chinese",
        "mathematics",
        "english",
        "politics"
      ]
    },
    "chapter": {
      "$ref": "#/$defs/namedNode"
    },
    "section": {
      "$ref": "#/$defs/namedNode"
    },
    "titles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "student": {
          "type": "string",
          "minLength": 1
        },
        "teacher": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quote_seed": {
      "type": "integer",
      "minimum": 0
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/occurrence"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "namedNode": {
      "type": "object",
      "required": [
        "key",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "occurrence": {
      "type": "object",
      "required": [
        "id",
        "question_id",
        "source_id",
        "locator",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "verified"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
