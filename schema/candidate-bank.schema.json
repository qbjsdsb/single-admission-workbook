{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/candidate-bank.schema.json",
  "title": "Candidate Question Bank",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "subject",
    "sections",
    "candidates",
    "groups",
    "non_question_occurrences",
    "blockers",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "english",
        "politics"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "non_question_occurrences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_question_occurrence"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "section_key",
        "kind",
        "heading",
        "heading_locator",
        "candidate_count",
        "inferred"
      ],
      "additionalProperties": false,
      "properties": {
        "section_key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string"
        },
        "heading_locator": {
          "type": "string",
          "minLength": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "inferred": {
          "type": "boolean"
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "label",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rich_node": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "blank" },
            "width_mm": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "rows"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "table" },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cells"],
                "additionalProperties": false,
                "properties": {
                  "cells": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["text", "grid_span"],
                      "additionalProperties": false,
                      "properties": {
                        "text": { "type": "string" },
                        "grid_span": { "type": "integer", "minimum": 1 },
                        "vertical_merge": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "source_id",
        "subject",
        "source_number",
        "section_key",
        "kind",
        "stem_text",
        "locators",
        "status",
        "review_reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "enum": [
            "english",
            "politics"
          ]
        },
        "source_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section_key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "single_choice",
            "fill_blank",
            "material_question",
            "composition"
          ]
        },
        "stem_text": {
          "type": "string"
        },
        "stem_rich": {
          "type": "array",
          "items": { "$ref": "#/$defs/rich_node" },
          "minItems": 1
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "parsed",
            "needs_review"
          ]
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 2,
          "maxItems": 4
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "single_choice"
              },
              "status": {
                "const": "parsed"
              }
            },
            "required": [
              "kind",
              "status"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "kind",
        "section_key",
        "label",
        "shared_material_text",
        "locators",
        "child_candidate_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "cloze_group",
            "reading_group"
          ]
        },
        "section_key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "shared_material_text": {
          "type": "string"
        },
        "shared_material_rich": {
          "type": "array",
          "items": { "$ref": "#/$defs/rich_node" },
          "minItems": 1
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "child_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_label": {
          "type": "string"
        },
        "label_locator": {
          "type": "string",
          "minLength": 1
        },
        "label_normalization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "non_question_occurrence": {
      "type": "object",
      "required": [
        "occurrence_id",
        "source_id",
        "source_number",
        "section_key",
        "locator",
        "reason_code",
        "text_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "occurrence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_number": {
          "type": "integer",
          "minimum": 1
        },
        "section_key": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "const": "leading_english_choice_instruction"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "blocker": {
      "type": "object",
      "required": [
        "locator",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "locator": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "candidate_count",
        "group_count",
        "non_question_occurrence_count",
        "blocker_count",
        "status_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "group_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_question_occurrence_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocker_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_counts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "parsed",
              "needs_review"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
