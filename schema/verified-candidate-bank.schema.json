{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/verified-candidate-bank.schema.json",
  "title": "Verified Candidate Bank",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "candidate_source_id",
    "verified",
    "rejected_candidate_ids",
    "deferred_candidate_ids",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "enum": [
        "english",
        "politics"
      ]
    },
    "candidate_source_id": {
      "type": "string",
      "minLength": 1
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "source_id",
          "subject",
          "source_number",
          "section_key",
          "kind",
          "stem_text",
          "options",
          "group_id",
          "locators",
          "verified_answer",
          "answer_mode",
          "verification_method",
          "verification_note",
          "override_reason",
          "machine_aggregate_status",
          "machine_answer"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "enum": [
              "english",
              "politics"
            ]
          },
          "source_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "section_key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "stem_text": {
            "type": "string"
          },
          "options": {
            "type": "array"
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "locators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified_answer": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "answer_mode": {
            "enum": [
              "fixed",
              "open_response"
            ]
          },
          "verification_method": {
            "enum": [
              "human_review",
              "editorial_source_review",
              "machine_corroborated_accepted",
              "source_pair_manual_approval",
              "source_pair_evidence_accepted"
            ]
          },
          "verification_note": {
            "type": "string"
          },
          "override_reason": {
            "type": "string"
          },
          "machine_aggregate_status": {
            "enum": [
              "machine_corroborated",
              "single_source_consistent",
              "review_required",
              "conflict"
            ]
          },
          "machine_answer": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rejected_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deferred_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "required": [
        "verified",
        "rejected",
        "deferred"
      ],
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
