{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/batch-review-summary.schema.json",
  "title": "Private Batch Review Summary",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "student_source_groups",
    "companion_sources",
    "candidate_units",
    "failed_student_groups",
    "states",
    "issue_counts",
    "verification_aggregate_counts",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "enum": [
        "english",
        "politics"
      ]
    },
    "student_source_groups": {
      "type": "integer",
      "minimum": 0
    },
    "companion_sources": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_units": {
      "type": "integer",
      "minimum": 0
    },
    "failed_student_groups": {
      "type": "integer",
      "minimum": 0
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "issue_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "verification_aggregate_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "status": {
      "const": "review_only_not_verified_or_publishable"
    }
  }
}
