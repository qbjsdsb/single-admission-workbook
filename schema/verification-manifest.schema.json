{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/verification-manifest.schema.json",
  "title": "Verification Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_source_id",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_source_id": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "decision",
          "method"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approve",
              "reject",
              "defer"
            ]
          },
          "method": {
            "enum": [
              "human_review",
              "editorial_source_review",
              "machine_corroborated_accepted",
              "source_pair_manual_approval",
              "source_pair_evidence_accepted"
            ]
          },
          "answer_mode": {
            "enum": [
              "fixed",
              "open_response"
            ]
          },
          "verified_answer": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "override_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
