{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/document.schema.json",
  "title": "Workbook Document AST v1",
  "type": "object",
  "required": ["version", "source_format", "blocks", "warnings"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "source_format": {"enum": ["docx", "pdf", "ocr", "image"]},
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "locator", "inlines"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "paragraph"},
            "locator": {"type": "string", "minLength": 1},
            "page": {"type": "integer", "minimum": 1},
            "bbox": {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"},
                {"type": "number"},
                {"type": "number"}
              ],
              "minItems": 4,
              "maxItems": 4
            },
            "inlines": {
              "type": "array",
              "items": {"$ref": "#/$defs/inline"}
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "locator", "feature"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "unsupported"},
            "locator": {"type": "string", "minLength": 1},
            "feature": {"type": "string", "minLength": 1},
            "raw": {"type": "string"},
            "page": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "text"},
            "text": {"type": "string"},
            "styles": {
              "type": "array",
              "items": {"enum": ["bold", "italic", "underline", "emphasis_dot"]},
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "xml", "locator", "status"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "math_omml"},
            "xml": {"type": "string"},
            "locator": {"type": "string"},
            "status": {"const": "captured_not_normalized"}
          }
        },
        {
          "type": "object",
          "required": ["type", "relationship_id", "locator", "status"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "image_ref"},
            "relationship_id": {"type": "string"},
            "locator": {"type": "string"},
            "status": {"const": "captured_not_normalized"}
          }
        }
      ]
    }
  }
}
