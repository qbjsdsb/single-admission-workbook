{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/sample-selection.schema.json",
  "title": "Private Sample Selection",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "selected_question_ids",
    "excluded",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "enum": [
        "chinese",
        "mathematics",
        "english",
        "politics"
      ]
    },
    "selected_question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "selected",
        "excluded"
      ],
      "additionalProperties": false,
      "properties": {
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
