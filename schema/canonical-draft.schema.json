{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/canonical-draft.schema.json",
  "title": "Canonical Draft Batch",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "candidate_source_id",
    "questions",
    "unresolved",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "enum": [
        "english",
        "politics"
      ]
    },
    "candidate_source_id": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "promoted",
        "unresolved"
      ],
      "additionalProperties": false,
      "properties": {
        "promoted": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
