{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/teacher-enrichment-batch.schema.json",
  "title": "Teacher Enrichment Batch",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_source_id",
    "evidence_source_id",
    "items",
    "unresolved",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_source_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_source_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "analysis": {
            "type": "string",
            "minLength": 1
          },
          "teacher_notes": {
            "type": "string",
            "minLength": 1
          },
          "source_sample_response": {
            "type": "string",
            "minLength": 1
          },
          "source_sample_response_provenance": {
            "$ref": "#/$defs/sourceSampleResponseProvenance"
          }
        },
        "dependentRequired": {
          "source_sample_response": ["source_sample_response_provenance"],
          "source_sample_response_provenance": ["source_sample_response"]
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "enriched",
        "unresolved"
      ],
      "additionalProperties": false,
      "properties": {
        "enriched": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sourceSampleResponseProvenance": {
      "type": "object",
      "required": ["evidence_source_id", "source_sha256", "evidence_ids", "locators", "paragraph_sha256", "response_sha256"],
      "additionalProperties": false,
      "properties": {
        "evidence_source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "paragraph_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
